# Vibe Lab 本地开发环境变量示例 —— 复制为 .env.local 并按需填写
# 注意：.env*.local 已被 gitignore，绝不要把真实密钥提交进公开仓库。

# 创作者数据仓库 token（private 阶段拉取用；vibe-lab 已转 public，可不填走 CDN）
VLAB_GH_TOKEN=

# MiniMax 生图/摘要（AI 封面）：api.minimax.chat
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat

# 训练营课程台第一道锁：邀请码（站长设置后人工发放给感兴趣的用户）
# 生产未配置时验证一律拒绝；本地 dev 未配置时放行方便联调
COURSE_INVITE_CODE=
